rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {};
    }

    function isMasterAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@royalroutes.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master_admin')
      );
    }

    function isDestinationAdmin() {
      return isAuthenticated() && (
        isMasterAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'destination_admin')
      );
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─── Users Collection ───────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) || isMasterAdmin();
      allow update: if isOwner(uid) || isMasterAdmin();
      allow delete: if isMasterAdmin();
    }

    // ─── Trips Collection ───────────────────────────────────────────────────────
    match /trips/{tripId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isMasterAdmin();
    }

    // ─── Destinations Collection ────────────────────────────────────────────────
    match /destinations/{destinationId} {
      allow read: if isAuthenticated();
      allow create, delete: if isMasterAdmin();
      allow update: if isMasterAdmin() || isDestinationAdmin();
    }

    // ─── Assignments Collection ─────────────────────────────────────────────────
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, delete: if isMasterAdmin();
      allow update: if isMasterAdmin() || isDestinationAdmin();
    }

    // ─── Itinerary Days & Items ─────────────────────────────────────────────────
    match /itineraryDays/{dayId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isMasterAdmin() || isDestinationAdmin();
    }

    match /itineraryItems/{itemId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isMasterAdmin() || isDestinationAdmin();
    }

    // ─── Hotels & Accommodations ────────────────────────────────────────────────
    match /hotels/{hotelId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isMasterAdmin() || isDestinationAdmin();
    }

    // ─── Transport & Logistics (Both names supported) ───────────────────────────
    match /transportBookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isMasterAdmin() || isDestinationAdmin();
    }

    match /transports/{transportId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isMasterAdmin() || isDestinationAdmin();
    }

    // ─── Expenses & Budgets ─────────────────────────────────────────────────────
    match /expenses/{expenseId} {
      allow read: if isMasterAdmin() || isDestinationAdmin();
      allow create, update, delete: if isMasterAdmin() || isDestinationAdmin();
    }

    // ─── Approvals & Reviews ───────────────────────────────────────────────────
    match /approvals/{approvalId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isMasterAdmin() || isDestinationAdmin();
    }

    // ─── Notifications & Activity Logs ──────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    match /activityLogs/{logId} {
      allow read: if isMasterAdmin() || isDestinationAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
